# Vercel 배포 번들에서 뺄 것들.
# 앱을 띄우는 데 필요 없는 파일을 빼면 번들이 작아지고 배포가 빨라진다.
# (파이썬 함수 번들 한도는 500MB. 의존성만으로 280MB 쯤 되므로 나머지는 줄여 둔다.)

# ★ 인증키 — 반드시 제외한다.
# .gitignore 는 git 에만 적용된다. `vercel deploy` 는 **로컬 폴더를 그대로 올리므로**
# 여기에 적지 않으면 .key 가 배포 번들에 실려 간다.
# 키는 파일이 아니라 Vercel 환경변수로 넣는다 (README 15.2).
.key
.env
.env.*

# 강의 원본 서브모듈 — 읽기 전용 참고 자료라 서버 구동과 무관하다
lecture/

# 실습 아카이브(`실습/`)는 **뺴지 않는다.** 배포본에서도 `/practice/` 로 열려야 한다.
# (HTML·CSS·JS 뿐이라 수백 KB 수준이다. 안의 README.md 는 아래 `*.md` 규칙으로 빠진다.)

# 개발 환경
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 문서·작업 기록
docs/
*.md
!README.md

# 로컬 데이터
# ⚠️ 아래 여덟 파일은 **반드시 올라가야 한다** (명세서 §8 배포 포함 데이터).
#      data/industry_map.json         DART 표준산업분류 3,925종목 (409KB) — 없으면 피어 선정이 죽는다
#      data/glossary.json             08강 용어 사전 427개 (180KB) — 리포트 용어 툴팁 (M5)
#      data/stock_master.json         국내 티커 판별 · 자동완성
#      data/us_master.json            미국 티커 판별 · S&P 500 표시
#      data/corp_code.json            DART 고유번호 매핑 — 없으면 재무·공시 전부 막힌다
#      data/market_snapshot.json.gz   스크리닝용 사전계산 (3,266종목)
#      data/krx_derived.json          거래일 캘린더 · 시장의 폭 (13KB) — M3 전처리와 `/market`
#      data/krx_bundle.db             전종목 150거래일 축약본 (30MB) — `/quant`·`/krx` 캔들
#      data/report_index.db           사업보고서 원문 색인 2,489곳 (18.4MB) — 배포본 slot 4·5·7 과
#                                     `/api/search/semantic` 자연어 검색 (없으면 배포본이 11장으로 돌아간다)
#
#    `krx_bundle.db` 와 `report_index.db` 는 **git 에는 없고 여기만 있다**
#    (데이터 원본이라 커밋하지 않는다 — `.gitignore` 참고).
#    `vercel deploy` 는 git 이 아니라 로컬 폴더를 그대로 올리므로 이렇게 갈라 둘 수 있다.
#    ⚠️ 그래서 **배포 전에 `python3 scripts/build_krx_bundle.py` 를 돌려야** 한다.
#       빼먹으면 배포본에서 `/quant` 4종과 `/krx` 캔들이 다시 죽는다.
#    `report_index.db` 는 매번 돌릴 필요가 없다 — 사업보고서가 새로 나올 때만 다시 만든다
#    (`python3 scripts/build_report_index.py` · 21분). 다만 **파일이 있어야** 배포본이 14장을 낸다.
#
#    번들 DB(30MB)를 왜 올리나 — 원본 캐시는 123MB 라 못 올리고, 그렇다고 빼면
#    전종목 × 여러 날치가 필요한 화면이 통째로 빈다. 파이썬 함수 한도는 500MB 다.
data/krx_cache.db
data/krx_cache.db-wal
data/krx_cache.db-shm
data/krx_bundle.db-wal
data/krx_bundle.db-shm
data/report_index.db-wal
data/report_index.db-shm
data/kosis_rss/
data/yf/

# Codespaces 설정 (Vercel 에서는 안 쓴다)
.devcontainer/

# 수집·차트 스크립트 — 웹 서버가 import 하지 않는다
scripts/
test.sh

# 회귀 검사 (node + jsdom) — 로컬에서만 돌린다
tests/
# 검사용 node 패키지(jsdom · apexcharts 32MB). 서버는 파이썬이라 쓰지 않는다.
# (`npm install --no-save jsdom apexcharts@4` 로 로컬에만 둔다)
node_modules/

# 에디터·OS
.vscode/
.idea/
.DS_Store
Thumbs.db
