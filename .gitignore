# 가상환경
.venv/
venv/
env/

# node 의존성 — 회귀 검사(jsdom)를 돌릴 때만 필요하고, `npm install jsdom` 으로 언제든 받는다
node_modules/

# 파이썬 캐시
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 환경변수 · 시크릿
.env
.env.*
*.key
.key

# 에디터 · OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# KRX 일별 시세 디스크 캐시 (용량이 크고 재생성 가능)
# scripts/fetch_krx.py 로 언제든 다시 만들 수 있으므로 저장소에 올리지 않는다.
data/krx_cache.db
data/krx_cache.db-wal
data/krx_cache.db-shm

# 배포용 축약본 (전종목 150거래일, 30MB) — `scripts/build_krx_bundle.py` 로 다시 만든다.
# 데이터 원본이라 커밋하지 않는다.
# ⚠️ `.vercelignore` 에는 **넣지 않는다.** 배포 번들에는 반드시 실려야 한다
#    (`vercel deploy` 는 git 이 아니라 로컬 폴더를 그대로 올리므로 이렇게 갈라 둘 수 있다).
# 함께 만들어지는 `data/krx_derived.json`(13KB) 은 반대로 **커밋한다** — 거래일 캘린더와
# 시장의 폭이 들어 있어 배포본·Codespaces 어디서나 있어야 한다.
data/krx_bundle.db
data/krx_bundle.db-wal
data/krx_bundle.db-shm

# 사업보고서 원문 색인 (전종목 2,489곳, 18.4MB) — `scripts/build_report_index.py` 로 다시 만든다.
# `krx_bundle.db` 와 **같은 규칙**이다: 데이터 원본이라 커밋하지 않고,
# `.vercelignore` 에는 넣지 않아 배포 번들에는 실린다.
# 빌드에 21분이 걸리고 DART 를 5천 번 부르므로, 새로 만들 일이 없으면 그대로 둔다
# (사업보고서는 연 1회 · 3월 집중).
data/report_index.db
data/report_index.db-wal
data/report_index.db-shm

# 재빌드 전 백업 (M9). 색인을 다시 만들 때는 **먼저 복사해 두고** 돌린다 —
# 빌드가 제자리(in-place)로 25곳마다 중간 저장하므로 중간에 끊기면 되돌릴 것이 없다.
# ★ `.vercelignore` 에도 **반드시** 넣는다 — 안 넣으면 배포 번들에 18MB 가 그냥 실린다.
data/*.bak

# KOSIS 공지 크롤링 결과 (재수집 가능한 산출물)
# ./test.sh 또는 scripts/kosis_rss.py 로 언제든 다시 만들 수 있다.
data/kosis_rss/

# yf.py 가 저장한 차트 이미지 (언제든 다시 그릴 수 있는 산출물)
data/yf/

# 에디터 스왑 파일
*.swp
*.swo
*~
.vercel

# 개발 서버 로그 (uvicorn 을 nohup 으로 띄울 때 생긴다)
uvicorn.log

# 작업 프롬프트 메모 (개인 작업 기록 — 저장소에 올리지 않는다)
프로젝트 작업 프롬프트*.txt
