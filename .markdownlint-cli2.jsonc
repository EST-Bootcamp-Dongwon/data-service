// markdownlint-cli2 설정 — `invoke docs-check` 가 이 파일을 자동으로 읽는다.
//
// 왜 설정이 필요했나 (2026-08-22 실측 · 2026-08-23 적용)
// -----------------------------------------------------
// 설정 파일이 없으면 기본값(영문 80자 · compact 표)으로 도는데, 그 상태에서
// `docs/**/*.md` + `README.md` 가 **6,500건 넘게** 걸렸다. 규칙별로 세어 보면:
//
//     MD060 4,170건 · MD013 2,038건 · MD040 187건 · MD036 66건 · 나머지 38건
//
// 즉 게이트가 "빨간불로 고정"돼 있어서 **아무것도 잡아 주지 못하는 상태**였다.
// 실정에 안 맞는 규칙 몇을 끄고 나머지를 실제로 고쳐, 게이트를 다시 살린다.
//
// ⚠️ 끄는 기준은 "고치기 귀찮아서"가 아니라 **이 레포의 문서 규약과 정면으로 충돌해서**다.
//    충돌하지 않는 것은 끄지 않고 고쳤다.
{
  "config": {
    // ── 이 레포의 규약과 충돌하는 것 ────────────────────────────

    // MD013 줄 길이 — 한국어 문서에 80자 기준은 뜻이 없다. 한글 한 글자가 2칸으로 세어져
    // 실제로는 40자 남짓에서 걸린다. 이 레포의 문체는 한 문장을 한 줄에 두고 100자
    // 근처에서 접는 것이고(ruff line-length 도 100), 표·코드블록은 더 길다.
    "MD013": false,

    // MD060 표 파이프 간격 — 이 레포는 표를 **세로로 맞춰** 읽기 좋게 쓴다.
    // compact 강제는 그 정렬을 전부 뭉갠다. ADR-DS-0005 가 `ruff format` 을 뺀 것과 같은 이유다.
    "MD060": false,

    // MD036 강조를 제목 대신 쓰지 말 것 — ADR·README 가 문단 안 소제목으로
    // **굵게** 를 의도적으로 쓴다. 제목(`###`)으로 올리면 목차가 오염된다.
    "MD036": false,

    // MD028 인용 블록 사이의 빈 줄 — ⚠️ 경고를 여러 개 나열할 때 생긴다.
    // 붙이면 한 덩어리로 읽혀 경고가 섞인다.
    "MD028": false,

    // MD033 인라인 HTML — 표 안 줄바꿈(`<br>`) 등에 쓴다. 마크다운만으로는 대체가 없다.
    "MD033": false,

    // MD040 코드펜스 언어 명시 — 187건. 대부분 폴더 구조도·출력 예시라 붙일 언어가
    // 마땅치 않다(`text` 를 187번 붙이는 것은 정보가 아니라 잡음이다).
    // ⚠️ 이것만은 **나중에 켤 여지가 있다.** 새 문서에서는 붙이는 쪽으로 쓴다.
    "MD040": false
  },

  // 검사 대상에서 뺄 것 — 생성물과 외부 사본
  "ignores": [
    "node_modules/**",
    ".venv/**",
    "lecture/**",
    "실습/**",
    // 옛 명세서 사본. 버전별로 얼려 둔 것이라 지금 규약으로 고치면 이력이 어긋난다.
    "docs/md/**"
  ]
}
