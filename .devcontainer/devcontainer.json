{
  // GitHub Codespaces 설정 — 저장소를 열면 이 파일대로 개발 환경이 만들어진다.
  //
  //   Code ▾ → Codespaces → Create codespace on main
  //
  // 컨테이너가 만들어지면 의존성을 설치하고 8000 포트로 서버를 자동 실행한다.
  // 강사님께 보여드릴 주소는 이 포트를 **Public 으로 바꾼 뒤** 나오는
  //   https://<코드스페이스이름>-8000.app.github.dev
  // 이다. 포트는 기본이 Private 라 반드시 한 번 바꿔 줘야 남이 열 수 있다.
  // (자세한 절차는 README 「15. 배포 · 공유」 참고)
  "name": "api-test — FastAPI 실습",

  // 로컬 개발 환경과 같은 3.12 로 맞춘다.
  // requirements.txt 가 버전을 고정해 두었기 때문에 파이썬이 달라지면 설치가 깨질 수 있다.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    // gh CLI — 포트 공개 범위를 터미널에서 바꿀 때 쓴다
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // 컨테이너를 만든 직후 1회. 여기서 시간이 좀 걸린다(2~3분).
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // 접속할 때마다 실행 — 서버를 백그라운드로 띄운다
  "postAttachCommand": "bash .devcontainer/start.sh",

  // 8000 포트를 자동으로 전달한다.
  // ⚠️ devcontainer.json 으로는 **공개 범위를 지정할 수 없다.**
  //    ("visibility": "public" 은 아직 지원되지 않는 요청 사항이다)
  //    그래서 start.sh 가 gh CLI 로 시도하고, 실패하면 수동 안내를 띄운다.
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "api-test (FastAPI)",
      // 서버가 뜨면 브라우저 미리보기를 자동으로 연다
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        // 컨테이너 안 가상환경이 아니라 시스템 파이썬을 그대로 쓴다
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.tabSize": 2
      }
    }
  },

  // 강의 원본(lecture/)은 읽기 전용 참고 자료다. 없어도 앱은 동작하지만,
  // 원본과 비교해 보려면 있는 편이 좋아서 함께 받는다.
  "updateContentCommand": "git submodule update --init --recursive || true"
}
